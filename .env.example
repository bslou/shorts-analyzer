# Required. Server-only. https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=

# Published Workflow URL slug from the workspace (not the display name).
# The app maps this to POST /infer/workflows/{workspace}/{workflow-id}.
ROBOFLOW_WORKFLOW_URL=https://serverless.roboflow.com/benjamin-sloutsky-s-workspace/workflows/shorts-visual-timeline-1791839058578

# Gemini 2.5 Flash editorial layer. Never silently switches to Pro or Flash-Lite.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_FRAMES=12
GEMINI_MAX_OUTPUT_TOKENS=16384
GEMINI_INPUT_USD_PER_MILLION=0.15
GEMINI_OUTPUT_USD_PER_MILLION=0.6

# Adaptive Roboflow sampling. Typical 35s Short lands in 24–36 frames.
ROBOFLOW_FRAME_INTERVAL_SECONDS=2
ROBOFLOW_HOOK_SECONDS=5
ROBOFLOW_HOOK_INTERVAL_SECONDS=1
ROBOFLOW_MIN_FRAMES=24
ROBOFLOW_MAX_FRAMES=36
ROBOFLOW_CREDITS_PER_IMAGE=0.000125
ROBOFLOW_USD_PER_IMAGE=0.0008

# Soft cap. Exceeding it requires explicit approval; quality is not reduced.
ANALYSIS_SOFT_BUDGET_USD=0.05
